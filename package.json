{
  "name": "@reachpad/mcp",
  "version": "0.2.0",
  "mcpName": "io.github.Reachpad/reachpad-mcp",
  "description": "Development infrastructure for coding agents: persistent cloud environments they create, operate and test software in, over API, MCP or CLI.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://reachpad.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reachpad/reachpad-mcp.git"
  },
  "bin": {
    "reachpad-mcp": "./src/server.js"
  },
  "exports": {
    ".": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reachpad",
    "coding-agents",
    "development-environment",
    "cloud-development-environment",
    "agent-infrastructure"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "ci": "node --test 'test/*.test.mjs'"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./src/server.d.ts"
}
