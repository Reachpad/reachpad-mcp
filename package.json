{
  "name": "@reachpad/mcp",
  "version": "0.4.2",
  "mcpName": "io.github.Reachpad/reachpad-mcp",
  "description": "reachpad lets Claude, Codex and other coding agents build full-stack apps in persistent workspaces and share them by link, without a separate deployment.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://reachpad.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reachpad/reachpad-mcp.git"
  },
  "bin": {
    "reachpad-mcp": "./src/server.js"
  },
  "exports": {
    ".": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reachpad",
    "coding-agents",
    "development-environment",
    "cloud-development-environment",
    "agent-infrastructure"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs' && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "ci": "npm test",
    "prepublishOnly": "node scripts/publish-guard.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "types": "./src/server.d.ts"
}
